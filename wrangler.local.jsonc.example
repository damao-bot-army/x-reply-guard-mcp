// Copy to wrangler.local.jsonc (git-ignored) and replace the placeholders with your real values.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x-reply-guard-mcp",
  // Optional custom domain: replace with your hostname, or remove to use x-reply-guard-mcp.<your-subdomain>.workers.dev.
  "routes": [{ "pattern": "x-reply-guard.example.com", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    "X_USER_ID": "REPLACE_WITH_NUMERIC_USER_ID",
    "X_USERNAME": "REPLACE_WITH_USERNAME",
    "PUBLISH_MODE": "approval",
    "MAX_POSTS_PER_HOUR": "5",
    "MAX_POSTS_PER_DAY": "20",
    "DRAFT_TTL_MINUTES": "30"
  },
  "durable_objects": {
    "bindings": [{ "name": "GUARD_STORE", "class_name": "GuardStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GuardStore"] }],
  "kv_namespaces": [
    // ID printed by: npx wrangler kv namespace create OAUTH_KV
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_NAMESPACE_ID" }
  ]
}
